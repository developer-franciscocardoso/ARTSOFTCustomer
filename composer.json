{
    "name": "francisco-cardoso/artsoft-customer",
    "description": "Reusable customer processing package for ERP integrations.",
    "type": "library",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../ARTSOFTConnector",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "FranciscoCardoso\\ARTSOFTCustomer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FranciscoCardoso\\ARTSOFTCustomer\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-simplexml": "*",
        "francisco-cardoso/artsoft-connector": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12"
    },
    "suggest": {
        "illuminate/console": "Required to use the artsoft-customer:publish Artisan command (^10.0|^11.0|^12.0)",
        "illuminate/support": "Required to use the Laravel service provider (^10.0|^11.0|^12.0)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FranciscoCardoso\\ARTSOFTCustomer\\ServiceProviders\\Laravel\\ArtsoftCustomerLaravelServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}